PORT=5002
MONGO_URL=mongodb://localhost:27017/nrapp
JWT_SECRET=replace_with_the_same_secret_used_by_auth_and_gateway
USER_SERVICE=http://localhost:5000
USER_SERVICE_TIMEOUT_MS=3000
CHAT_INTERNAL_SECRET=
CHAT_SIGNATURE_MAX_AGE_MS=300000
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Structured log + OpenTelemetry (local development)
LOG_LEVEL=debug
LOG_FORMAT=pretty
OTEL_SERVICE_NAME=chat
OTEL_SERVICE_VERSION=development
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_METRIC_EXPORT_TIMEOUT=10000
OTEL_HTTP_IGNORE_INCOMING_PATHS=/health,/healthz,/ready,/readiness
